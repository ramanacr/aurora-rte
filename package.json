{
  "name": "aurora-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run property",
    "test:security": "vitest run security",
    "test:a11y": "vitest run a11y",
    "test:perf": "vitest run perf",
    "test:bridges": "vitest run bridge",
    "test:enterprise": "vitest run enterprise",
    "check-boundaries": "node scripts/check-package-boundaries.mjs",
    "typecheck": "tsc --build",
    "version:bump": "node scripts/auto-version.mjs",
    "package:all": "node scripts/package-all.mjs",
    "release:check": "node scripts/check-package-boundaries.mjs && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.10.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
