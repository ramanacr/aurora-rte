{
  "name": "aurora-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run --testPathPattern=property",
    "test:security": "vitest run --testPathPattern=security",
    "test:a11y": "vitest run --testPathPattern=a11y",
    "test:bridges": "vitest run --testPathPattern=bridges|bridge",
    "test:enterprise": "vitest run --testPathPattern=enterprise",
    "check-boundaries": "node scripts/check-package-boundaries.mjs",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
